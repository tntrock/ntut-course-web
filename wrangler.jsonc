{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ntut-course-web",
  "compatibility_date": "2026-09-03",
  "observability": { "enabled": true },

  // 在資產前面補上逐頁的 <head>,給不跑 JS 的爬蟲看。見 worker/index.ts
  "main": "worker/index.ts",

  "assets": {
    "directory": "dist",
    "binding": "ASSETS",

    // SPA fallback。Workers Static Assets 用這個設定,**不能**用 _redirects 寫
    // `/* /index.html 200` —— 那會被判定成無限迴圈,部署直接失敗。
    // 直接開 /course/115-1/364893 這種深層網址時,回傳 index.html 由前端路由接手。
    "not_found_handling": "single-page-application",

    // **沒有這一段 Worker 根本不會被叫到。** 預設的隱式路由會看
    // `Sec-Fetch-Mode: navigate`:導覽請求配不到實體檔案時直接走
    // not_found_handling,不經過 Worker。
    //
    // 例外清單列的是 dist 裡真的存在的檔案 —— 它們直接由資產伺服器回,
    // 不算 Worker 請求(免費方案的額度是照 Worker 請求算的)。
    "run_worker_first": [
      "/*",
      "!/assets/*",
      "!/*.js",
      "!/*.png",
      "!/*.svg",
      "!/*.txt",
      "!/*.xml",
      "!/*.webmanifest",
      "!/*.ico",
    ],
  },
}
